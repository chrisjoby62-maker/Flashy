-- UI refresh --------------------------------------------------
local function refreshUI()
	local info = TweenInfo.new(0.2, Enum.EasingStyle.Quad)

	if settings.enabled then
		toggleText.Text = "SAFE MODE ON"
		toggleText.Position = UDim2.new(0, 14, 0, 0)
		TweenService:Create(toggle, info, { BackgroundColor3 = C.on }):Play()
		TweenService:Create(knob, info, { Position = UDim2.new(1, -32, 0.5, -14) }):Play()
	else
		toggleText.Text = "SAFE MODE OFF"
		toggleText.Position = UDim2.new(0, -14, 0, 0)
		TweenService:Create(toggle, info, { BackgroundColor3 = C.off }):Play()
		TweenService:Create(knob, info, { Position = UDim2.new(0, 4, 0.5, -14) }):Play()
	end

	if inSky then
		status.Text = "Chilling in the sky"
		dot.BackgroundColor3 = C.sky
	else
		status.Text = "Feet on the ground"
		dot.BackgroundColor3 = C.on
	end
end

local function getThreshold(hum)
	if settings.usePercent then
		return hum.MaxHealth * (settings.threshold / 100)
	end
	return settings.threshold
end

-- Invisible barrier breaker -----------------------------------
local function breakBarriers()
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsA("Terrain")
			and d.CanCollide and d.Transparency >= 0.9 then
			local model = d:FindFirstAncestorOfClass("Model")
			local isCharacter = model and model:FindFirstChildOfClass("Humanoid")
			if not isCharacter then
				brokenBarriers[d] = true
				d.CanCollide = false
			end
		end
	end
end

local function restoreBarriers()
	for part in pairs(brokenBarriers) do
		if part and part.Parent then
			part.CanCollide = true
		end
	end
	brokenBarriers = {}
end

-- noclip while in the sky
RunService.Stepped:Connect(function()
	if inSky and currentChar then
		for _, p in ipairs(currentChar:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CanCollide = false
			end
		end
	end
end)

-- Safe mode logic ---------------------------------------------
local function cleanup()
	if align then align:Destroy() align = nil end
	if attachment then attachment:Destroy() attachment = nil end
end

local function moveTo(pos, onDone)
	local tween = TweenService:Create(align, TweenInfo.new(settings.tweenTime, Enum.EasingStyle.Linear), { Position = pos })
	tween:Play()
	if onDone then tween.Completed:Connect(onDone) end
end

local function goSky(root)
	inSky = true
	token += 1
	returnPos = root.Position

	breakBarriers()
	cleanup()
	attachment = Instance.new("Attachment")
	attachment.Parent = root

	align = Instance.new("AlignPosition")
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.MaxForce = math.huge
	align.MaxVelocity = math.huge
	align.Responsiveness = 200
	align.ApplyAtCenterOfMass = true
	align.Position = root.Position
	align.Parent = root

	moveTo(returnPos + Vector3.new(0, settings.height, 0))
	refreshUI()
end

local function land()
	if not align then
		inSky = false
		restoreBarriers()
		refreshUI()
		return
	end
	inSky = false
	local myToken = token
	moveTo(returnPos, function()
		if token == myToken then
			cleanup()
			restoreBarriers()
		end
	end)
	refreshUI()
end

local function check()
	if not (currentHum and currentRoot and currentHum.Health > 0) then return end

	if not settings.enabled then
		if inSky then land() end
		return
	end

	-- once up, you stay up until Safe Mode is turned off
	if not inSky and currentHum.Health <= getThreshold(currentHum) then
		goSky(currentRoot)
	end
end

local function onCharacter(char)
	inSky = false
	token += 1
	cleanup()
	restoreBarriers()
	currentChar = char
	currentHum = char:WaitForChild("Humanoid")
	currentRoot = char:WaitForChild("HumanoidRootPart")
	currentHum.HealthChanged:Connect(check)
	currentHum.Died:Connect(function()
		inSky = false
		token += 1
		cleanup()
		restoreBarriers()
		refreshUI()
	end)
	refreshUI()
end

box.FocusLost:Connect(function()
	local text = box.Text:gsub("%s", "")
	local isPercent = text:sub(-1) == "%"
	local num = tonumber(isPercent and text:sub(1, -2) or text)
	if num and num > 0 then
		settings.threshold = num
		settings.usePercent = isPercent
	else
		box.Text = tostring(settings.threshold) .. (settings.usePercent and "%" or "")
	end
	check()
end)

toggle.Activated:Connect(function()
	settings.enabled = not settings.enabled
	refreshUI()
	check()
end)

player.CharacterAdded:Connect(onCharacter)
if player.Character then onCharacter(player.Character) end
refreshUI()
